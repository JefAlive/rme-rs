{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo check --workspace",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "cargo run",
      "type": "shell",
      "command": "cargo run",
      "group": "none",
      "problemMatcher": "$rustc"
    }
  ]
}